{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HGhub",
  "version": "1.1.0",
  "identifier": "com.hghub.huangguo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/sync-android-icons.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HGhub",
        "width": 1200,
        "height": 780
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}